# COPY this file to .env and enter YOUR OWN credentials. Never commit .env.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=replace_with_your_tavily_api_key
AVIATIONSTACK_API_KEY=replace_with_your_aviationstack_api_key
OPENWEATHER_API_KEY=replace_with_your_openweathermap_api_key

# The local database is a PostgreSQL DB you created separately.
# URL-encode reserved characters in the password (e.g. @ becomes %40).
DATABASE_URL=postgresql://postgres:replace_with_url_encoded_password@localhost:5432/ashwani_travel_agent

# Windows location of cloned aviationstack-mcp's own virtual environment.
# Relative paths are relative to this repository root.
AVIATION_MCP_PYTHON=aviationstack-mcp/.venv/Scripts/python.exe
# For macOS/Linux, use: aviationstack-mcp/.venv/bin/python
